# GreenMove Production Environment Configuration Placeholders

# ===================================================================
# FRONTEND CONFIGURATION (Vercel)
# ===================================================================
# Base URL pointing to Render Spring Boot Backend (No trailing slash)
VITE_API_BASE_URL=https://your-render-backend.onrender.com

# OpenRouteService API Key for Routing Fallback (optional - used if configured)
VITE_ORS_API_KEY=your_openrouteservice_api_key

# OSRM routing engine base URL (free, keyless fallback for real road-network routes).
# Optional - defaults to the public OSRM demo server (https://router.project-osrm.org)
# when left unset. Only override this if you are self-hosting OSRM for production-scale
# traffic (the public demo server is rate-limited to ~1 request/second and is intended
# for reasonable, non-commercial use).
VITE_OSRM_BASE_URL=https://router.project-osrm.org

# MapTiler Vector Maps API Key
VITE_MAPTILER_API_KEY=your_maptiler_api_key

# Google OAuth 2.0 Web Client ID (Google Cloud Console -> APIs & Services -> Credentials)
# Required for the "Continue with Google" button on Sign In / Sign Up. Must match GOOGLE_CLIENT_ID below.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# ===================================================================
# BACKEND CONFIGURATION (Render)
# ===================================================================
# Active Spring Profile (test for in-memory H2, prod for PostgreSQL)
SPRING_PROFILES_ACTIVE=prod

# Server Port (Render sets PORT automatically, defaults to 8080)
PORT=8080

# Google Routes v2 API Key (optional).
# When configured, this powers primary traffic-aware routing via the backend proxy.
# If left unset, or if the Google Routes API call fails for any reason, the frontend
# automatically falls back to OpenRouteService (if VITE_ORS_API_KEY is set) and then
# to the free, keyless OSRM routing engine, so Plan Route keeps returning a real
# road-network route with distance/duration even with zero paid keys configured.
GOOGLE_ROUTES_API_KEY=your_google_routes_api_key

# OpenChargeMap API Key (must be named OPEN_CHARGE_MAP_API_KEY to match
# greenmove.ev.ocm-api-key in backend/src/main/resources/application.yml)
OPEN_CHARGE_MAP_API_KEY=your_openchargemap_api_key

# TomTom EV Routing Key (Optional / Private Preview)
TOMTOM_API_KEY=your_tomtom_api_key

# Google OAuth 2.0 Web Client ID - must match VITE_GOOGLE_CLIENT_ID above.
# Used by the backend to verify "Continue with Google" ID tokens. Leave unset to disable Google Sign-In.
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# Secret key used to sign user authentication JWTs. Generate a long random string, e.g.:
#   openssl rand -base64 48
# MUST be changed from the placeholder in any real deployment.
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# JWT access token lifetime in milliseconds (default: 7 days)
JWT_EXPIRATION_MS=604800000

# Brevo transactional email (signup verification, email-change verification, security
# notifications). Get an API key from Brevo -> SMTP & API -> API Keys. Backend-only - never
# exposed to the frontend/browser. If unset, the backend logs what it would have sent instead
# of actually delivering it (safe for local dev, NOT acceptable in production).
BREVO_API_KEY=your_brevo_api_key
# Must be a sender/domain you've verified in Brevo, or sends will be rejected.
BREVO_SENDER_EMAIL=no-reply@your-verified-domain.com
BREVO_SENDER_NAME=GreenMove

# Base URL of the deployed frontend (Vercel), no trailing slash. Used to build the links inside
# verification/email-change emails (e.g. https://your-app.vercel.app/verify-email?token=...).
# Falls back to http://localhost:5173 if unset - MUST be set in production or emailed links will
# point at localhost. This is the only frontend-URL variable; there is no separate FRONTEND_URL.
GREENMOVE_FRONTEND_URL=https://your-frontend.vercel.app

# Production Supabase PostgreSQL Database Configuration (Render → Supabase)
# Connection String Format: jdbc:postgresql://db.<project_ref>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<supabase_project_ref>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password

# Alternative standard variable names:
DB_URL=jdbc:postgresql://db.<supabase_project_ref>.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_db_password
